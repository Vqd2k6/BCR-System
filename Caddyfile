:80 {
    # Serve Web Admin Portal
    handle /admin* {
        root * /srv/frontend/web_admin
        file_server
        try_files {path} /index.html
    }

    # Serve Mobile PWA
    handle /pwa* {
        root * /srv/frontend/mobile_pwa
        file_server
        try_files {path} /index.html
    }

    # Reverse Proxy Backend REST API
    handle /api/* {
        reverse_proxy backend_api:5000
    }

    handle /health* {
        reverse_proxy backend_api:5000
    }

    # Default redirect to Web Admin
    handle {
        root * /srv/frontend/web_admin
        file_server
        try_files {path} /index.html
    }
}
