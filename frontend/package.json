{
  "name": "metro2-survey-pwa",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check:zero-any": "node scripts/check-zero-any.js",
    "check:ui": "node scripts/check-ui-interactions.js",
    "check:catch": "node scripts/check-catch-clauses.js",
    "check:theme": "node scripts/check-theme-colors.js",
    "test:condo-absence-parity": "esbuild ../backend/src/scripts/test_condo_absence_preview_parity.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=node_modules/.cache/condo-absence-parity.test.cjs --log-level=warning && node node_modules/.cache/condo-absence-parity.test.cjs",
    "test:ctx-replace": "esbuild scripts/ctx-replace.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/ctx-replace.test.cjs --log-level=warning && node node_modules/.cache/ctx-replace.test.cjs",
    "test:condo-adapters": "esbuild scripts/condo-adapters.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/condo-adapters.test.cjs --log-level=warning && node node_modules/.cache/condo-adapters.test.cjs",
    "test:restricted-area": "esbuild scripts/restricted-area.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/restricted-area.test.cjs --log-level=warning && node node_modules/.cache/restricted-area.test.cjs",
    "test:cad-lab": "esbuild scripts/cad-lab.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/cad-lab.test.cjs --log-level=warning && node node_modules/.cache/cad-lab.test.cjs"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "canvas-confetti": "^1.9.2",
    "clsx": "^2.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.359.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^18.19.31",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.2.2",
    "vite": "^4.5.2"
  }
}
