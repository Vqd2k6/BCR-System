# ============================================================================
# CẤU HÌNH MÔI TRƯỜNG SẢN XUẤT (PRODUCTION ENV CONFIG) - DỰ ÁN METRO 2 BẢN ĐỒ KHẢO SÁT
# ============================================================================

# 1. SERVER & SYSTEM
PORT=4000
NODE_ENV=production
API_PREFIX=/api/v1

# 2. CƠ SỞ DỮ LIỆU POSTGRESQL 16 + POSTGIS (SUPABASE / AWS RDS / RENDER PROD)
# Lưu ý: Trên Production bắt buộc cấu hình Connection Pooling và SSL Mode an toàn
DB_HOST=your-production-db-host.postgres.database.azure.com
DB_PORT=5432
DB_USER=metro2_admin
DB_PASSWORD=your_super_strong_production_password_2026
DB_NAME=metro2_gis_prod
DB_SSL=true
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# 3. BẢO MẬT & JWT AUTHENTICATION
# Tạo khóa ngẫu nhiên bằng lệnh: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=production_secret_key_metro2_jwt_maur_kfw_sha512_random_bytes_min_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=production_refresh_jwt_key_metro2_maur_kfw_sha512_random_bytes_min_64_chars
JWT_REFRESH_EXPIRES_IN=30d

# 4. LƯU TRỮ ĐÁM MÂY CLOUDFLARE R2 (S3-COMPATIBLE)
STORAGE_TYPE=r2
S3_ENDPOINT=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=metro2-survey-photos-prod
S3_ACCESS_KEY_ID=<your-r2-access-key-id>
S3_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_PUBLIC_URL=https://pub-<your-r2-hash>.r2.dev
LOCAL_UPLOAD_DIR=./uploads

# 5. KẾT XUẤT BÁO CÁO KỸ THUẬT PDF (PUPPETEER HEADLESS CHROMIUM)
# Trên máy chủ Linux/Docker (Alpine/Debian), trỏ tới Chromium binary đã cài đặt
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# 6. MÁY CHỦ TRÍ TUỆ NHÂN TẠO (AI WORKER CHUẨN HÓA MẶT ĐỨNG CAD)
AI_WORKER_URL=http://ai-worker.metro2-internal:5000/api/ai/rectify
AI_API_KEY=production_ai_key_metro2_2026

# 7. PHÂN QUYỀN MẠNG & CORS ORIGINS (DANH SÁCH TÊN MIỀN HỢP LỆ)
# Chỉ cho phép domain chính thức của dự án và các trang Vercel/PWA đã đăng ký
CORS_ORIGIN=https://metro2-survey.tphcm.gov.vn,https://*.vercel.app
