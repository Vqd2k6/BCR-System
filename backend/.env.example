PORT=5000
NODE_ENV=development

# CƠ SỞ DỮ LIỆU POSTGRESQL + POSTGIS
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ksqh_metro2

# XÁC THỰC JWT
JWT_SECRET=ksqh_metro2_jwt_super_secret_key_2026
