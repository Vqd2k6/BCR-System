# ============================================================================
# CẤU HÌNH MÔI TRƯỜNG HỆ THỐNG KHẢO SÁT QUY HOẠCH METRO 2 (ENV CONFIG)
# ============================================================================

PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# Cấu hình PostgreSQL 16 + PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_USER=metro2_user
DB_PASSWORD=metro2_secure_password
DB_NAME=metro2_gis_db
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# Cấu hình JWT Authentication (Hạn Access Token 7 ngày = 604800s, Refresh Token 30 ngày)
JWT_SECRET=super_secret_metro2_jwt_key_2026_maur_kfw_secure
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_metro2_refresh_jwt_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# Cấu hình Lưu trữ S3-compatible (AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=https://432aeb7fff492aef97014cb7a7e291b0.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=metro2-survey-photos
S3_ACCESS_KEY_ID=mock_access_key
S3_SECRET_ACCESS_KEY=mock_secret_key
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev
STORAGE_TYPE=local # 'local' hoặc 'r2' hoặc 's3'
LOCAL_UPLOAD_DIR=./uploads

# Cấu hình AI Worker (Nắn thẳng mặt đứng chuẩn CAD)
AI_WORKER_URL=http://localhost:5000/api/ai/rectify
AI_API_KEY=mock_ai_key_2026

# Cấu hình CORS
CORS_ORIGIN=*
