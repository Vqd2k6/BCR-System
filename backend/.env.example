# ============================================================================
# CẤU HÌNH MÔI TRƯỜNG BACKEND API - METRO 2 SURVEY PLATFORM
# ============================================================================

PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgresql://metro_user:metro_pass@localhost:5432/metro2_survey

# JWT Authentication
JWT_SECRET=metro2_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# S3 / MinIO Object Storage (Lưu trữ ảnh đa lớp)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=metro_minio_admin
S3_SECRET_KEY=metro_minio_secret_key
S3_BUCKET_NAME=metro2-photos
S3_REGION=us-east-1
