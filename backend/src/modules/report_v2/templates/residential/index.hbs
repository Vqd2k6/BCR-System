<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>{{metadata.reportTitleVi}} - {{metadata.buildingId}}</title>
  <style>
    {{{styles}}}
  </style>
</head>
<body>


  <!-- =====================================================================
       TRANG 1: TRANG BÌA BÁO CÁO (COVER PAGE)
       ===================================================================== -->
  <div class="a4-page-sheet">
    
  <!-- HEADER CHUẨN 3 CỘT (LIÊN DANH THACO REC - METRO 2) -->
  <table class="report-running-header">
    <tr>
      <td class="col-logo">
        {{#if metadata.headerLogoBase64}}
          <img src="{{metadata.headerLogoBase64}}" alt="Logo THACO REC">
        {{else}}
          <div style="font-weight: bold; font-size: 11pt; color: #003366;">THACO REC</div>
        {{/if}}
      </td>
      <td class="col-title">
        <div class="main-title">Ho Chi Minh City Mass Rapid Transit Line2</div>
        <div class="sub-title">Ben Thanh - Tham Luong Route</div>
        <div class="doc-kind">Building Condition Survey and Assessment</div>
      </td>
      <td class="col-meta">
        <strong>Doc.No:</strong> {{metadata.reportNo}}<br>
        <strong>Date:</strong> {{metadata.surveyDateFormatted}}<br>
        <strong>Rev No:</strong> {{metadata.revision}}<br>
        <strong>Page:</strong> 1 of <span id="report-total-pages">{{metadata.totalExpectedPages}}</span>
      </td>
    </tr>
  </table>


    <div class="cover-page-border">
      <!-- TIÊU ĐỀ DỰ ÁN (PROJECT TITLE) -->
      <div class="cover-project-box">
        <div style="font-size: 9pt; font-weight: bold; color: #000000; margin-bottom: 2px;">
          PROJECT TITLE:
        </div>
        <div style="font-size: 9.5pt; font-weight: bold; color: #000000; margin-bottom: 2px;">
          {{metadata.projectTitleVi}}
        </div>
        <div style="font-size: 9pt; color: #334155; margin-bottom: 2px;">
          {{metadata.projectTitleEn}}
        </div>
        <div style="font-size: 8.5pt; font-weight: bold; color: #475569;">
          EPC Contract
        </div>
      </div>

      <!-- TIÊU ĐỀ CHÍNH BÁO CÁO -->
      <div class="cover-doc-title-box">
        <h1>{{metadata.reportTitleVi}}</h1>
        <h2>{{metadata.reportTitleEn}}</h2>
        <div class="cover-id-badge">
          Mã công trình/Building ID: {{metadata.buildingId}} &nbsp;|&nbsp; Mã khảo sát/Survey ID: {{metadata.surveyId}}
        </div>
      </div>

      <!-- ẢNH MẶT TIỀN TRUNG TÂM TRANG BÌA (P-02) -->
      <div class="cover-facade-section">
        <div class="cover-facade-wrapper">
          {{#if metadata.coverPhotoBase64}}
            <img src="{{metadata.coverPhotoBase64}}" class="cover-facade-photo" alt="Ảnh mặt tiền chính công trình">
          {{else if metadata.coverPhotoUrl}}
            <img src="{{metadata.coverPhotoUrl}}" class="cover-facade-photo" alt="Ảnh mặt tiền chính công trình">
          {{else}}
            <div class="photo-placeholder" style="width: 320px; height: 200px; margin: 0 auto;">
              [ Chưa có ảnh mặt tiền chính P-02 ]
            </div>
          {{/if}}
          {{#if metadata.coverPhotoUrl}}
            {{#unless metadata.coverAlreadyWatermarked}}
              {{#if metadata.headerLogoBase64}}
                <img src="{{metadata.headerLogoBase64}}" class="watermark-logo-top-right" alt="THACO REG">
              {{/if}}
              <div class="watermark-text-bottom-right">
                <div class="watermark-datetime">{{#if metadata.watermarkDateTime}}{{metadata.watermarkDateTime}}{{else}}{{metadata.surveyDateFormatted}}{{/if}}</div>
                <div class="watermark-code">HCM_M2.[{{metadata.buildingId}}]_P02_MAIN</div>
              </div>
            {{/unless}}
          {{/if}}
        </div>
      </div>

      <!-- ĐỊA CHỈ VÀ THỜI GIAN KHẢO SÁT -->
      <div class="cover-address-section">
        ĐỊA CHỈ: {{section1.address.vi}}<br>
        ADD: {{section1.address.en}}
      </div>

      <div class="cover-time-section">
        THỜI GIAN/TIME: {{metadata.surveyDateFormatted}}
      </div>

      <!-- BẢNG KÝ DUYỆT 3 BÊN -->
      <table class="signature-table">
        <thead>
          <tr>
            {{#each signatures3Party}}
              <th>{{this.roleVi}}<br><span style="font-size: 7.5pt; font-weight: normal;">{{this.roleEn}}</span></th>
            {{/each}}
          </tr>
        </thead>
        <tbody>
          <tr>
            {{#each signatures3Party}}
              <td>
                <div style="font-size: 7.5pt; color: #475569; margin-bottom: 2px;">HỌ TÊN / FULL NAME</div>
                <div class="font-bold" style="font-size: 9pt; color: #000000; min-height: 14px; margin-bottom: 2px;">
                  {{#if this.fullName}}{{this.fullName}}{{else}}&nbsp;{{/if}}
                </div>
                <div style="font-size: 7.5pt; color: #64748b; margin-bottom: 4px;">{{this.titleVi}}</div>
                
                <div style="font-size: 7.5pt; color: #475569; margin-bottom: 2px;">CHỮ KÝ / SIGNATURE</div>
                <div class="signature-box">
                  {{#if this.signatureBase64}}
                    <img src="{{this.signatureBase64}}" alt="Chữ ký">
                  {{else if this.signatureUrl}}
                    <img src="{{this.signatureUrl}}" alt="Chữ ký">
                  {{else if this.fullName}}
                    <span style="color: #94a3b8; font-style: italic; font-size: 7.5pt;">[ Đã ký điện tử ]</span>
                  {{else}}
                    <span style="color: #cbd5e1; font-style: italic; font-size: 7pt;">(Ký sống)</span>
                  {{/if}}
                </div>

                <div style="font-size: 7.5pt; color: #000000; font-weight: bold; border-top: 1px dotted #cbd5e1; padding-top: 4px;">
                  NGÀY / DATE: {{#if this.date}}{{this.date}}{{else}}&nbsp;{{/if}}
                </div>
              </td>
            {{/each}}
          </tr>
        </tbody>
      </table>
    </div>

    <div class="page-number-footer">1</div>
  </div>

  <!-- =====================================================================
       TRANG 2: MỤC LỤC BÁO CÁO (TABLE OF CONTENTS)
       ===================================================================== -->
  <div class="a4-page-sheet">
    
  <div class="report-subpage-topbar">
    <span>LIÊN DANH CRLG – CRSRI – TT | TUYẾN METRO 2 BẾN THÀNH - THAM LƯƠNG</span>
    <span>{{metadata.buildingId}} | {{metadata.reportNo}}</span>
  </div>


    <div class="toc-container">
      <h2 class="toc-title">MỤC LỤC / TABLE OF CONTENTS</h2>

      <ul class="toc-list">
        <li class="toc-item">
          <span>I. THÔNG TIN CHUNG - GENERAL INFORMATION</span>
          <span>{{tocPageNumbers.section1}}</span>
        </li>
        <li class="toc-item">
          <span>II. THÔNG TIN CƠ BẢN VỀ TÒA NHÀ - BASIC BUILDING INFORMATION</span>
          <span>{{tocPageNumbers.section2}}</span>
        </li>
        <li class="toc-item">
          <span>III. LỊCH SỬ VÀ TÌNH TRẠNG SỬ DỤNG - BUILDING HISTORY AND OCCUPANCY</span>
          <span>{{tocPageNumbers.section3}}</span>
        </li>
        <li class="toc-item">
          <span>IV. ĐẶC ĐIỂM KẾT CẤU VÀ MÓNG - STRUCTURAL AND FOUNDATION CHARACTERISTICS</span>
          <span>{{tocPageNumbers.section4}}</span>
        </li>
        <li class="toc-item">
          <span>V. ĐỘ NGHIÊNG/LÚN - GHI NHẬN SƠ BỘ - PRELIMINARY TILT/SETTLEMENT INDICATORS</span>
          <span>{{tocPageNumbers.section5}}</span>
        </li>
        <li class="toc-item">
          <span>VI. TÓM TẮT TÌNH TRẠNG ĐIỀU TRA LỖI - SUMMARY OF DEFECT INVESTIGATION</span>
          <span>{{tocPageNumbers.section6}}</span>
        </li>
        <li class="toc-item">
          <span>VII. PHÂN LOẠI MỨC ĐỘ HƯ HẠI THEO BURLAND - BURLAND DAMAGE CLASSIFICATION</span>
          <span>{{tocPageNumbers.section7}}</span>
        </li>
        <li class="toc-item">
          <span>VIII. ĐÁNH GIÁ TÌNH TRẠNG CÔNG TRÌNH - BUILDING CONDITION ASSESSMENT</span>
          <span>{{tocPageNumbers.section8}}</span>
        </li>
        <li class="toc-item sub">
          <span>1. Đánh giá theo ma trận rủi ro - Risk Matrix Assessment</span>
          <span>{{tocPageNumbers.section8}}</span>
        </li>
        <li class="toc-item sub">
          <span>2. Chấm điểm đánh giá rủi ro công trình - Building Risk Assessment Scoring</span>
          <span>{{tocPageNumbers.section8}}</span>
        </li>
        <li class="toc-item sub">
          <span>3. Cấp độ rủi ro tổng thể - Overall Risk Grade</span>
          <span>{{tocPageNumbers.section8}}</span>
        </li>
        <li class="toc-item sub">
          <span>4. Đánh giá bổ sung theo phương pháp Giai đoạn 1 (*) (ECS / VI / BRA V×I)</span>
          <span>{{tocPageNumbers.section8}}</span>
        </li>
        <li class="toc-item">
          <span>IX. KẾT LUẬN VÀ KIẾN NGHỊ - CONCLUSION AND RECOMMENDATION</span>
          <span>{{tocPageNumbers.section9}}</span>
        </li>
        <li class="toc-item appendix">
          <span>PHỤ LỤC 1: BẢN VẼ MẶT ĐỨNG NGOÀI CÔNG TRÌNH (EXTERIOR ELEVATIONS)</span>
          <span>{{tocPageNumbers.appendix1}}</span>
        </li>
        <li class="toc-item appendix">
          <span>PHỤ LỤC 2: THỐNG KÊ KHUYẾT TẬT TRÊN MẶT BẰNG TẦNG (FLOOR DEFECTS)</span>
          <span>{{tocPageNumbers.appendix2}}</span>
        </li>
        <li class="toc-item appendix">
          <span>PHỤ LỤC 3: BIÊN BẢN KHẢO SÁT HIỆN TRƯỜNG (*) (SIGNED SITE-SURVEY RECORD)</span>
          <span>{{tocPageNumbers.appendix3}}</span>
        </li>
        <li class="toc-item appendix">
          <span>PHỤ LỤC 4: THIẾT BỊ VÀ PHẠM VI TIẾP CẬN (*) (EQUIPMENT AND ACCESS)</span>
          <span>{{tocPageNumbers.appendix4}}</span>
        </li>
      </ul>
    </div>

    <div class="page-number-footer">2</div>
  </div>

  <!-- =====================================================================
       TRANG 3: CHƯƠNG I & II (THÔNG TIN CHUNG & THÔNG TIN CƠ BẢN TÒA NHÀ)
       ===================================================================== -->
  <div class="a4-page-sheet">
    
  <div class="report-subpage-topbar">
    <span>LIÊN DANH CRLG – CRSRI – TT | TUYẾN METRO 2 BẾN THÀNH - THAM LƯƠNG</span>
    <span>{{metadata.buildingId}} | {{metadata.reportNo}}</span>
  </div>


    <h2 class="chapter-header">I. THÔNG TIN CHUNG - GENERAL INFORMATION</h2>
    <table class="tech-table">
      <tr>
        <td class="label-col">Dự án<br><span class="text-muted">Project</span></td>
        <td class="val-col font-bold">
          {{section1.projectTitleVi}}<br>
          <span class="text-muted">{{section1.projectTitleEn}}</span>
        </td>
      </tr>
      <tr>
        <td class="label-col">Mã công trình<br><span class="text-muted">Building ID</span></td>
        <td class="val-col font-bold" style="color: #0f3b6c;">{{section1.buildingId}}</td>
      </tr>
      <tr>
        <td class="label-col">Mã khảo sát (*)<br><span class="text-muted">Survey ID</span></td>
        <td class="val-col">{{section1.surveyId}}</td>
      </tr>
      <tr>
        <td class="label-col">Số hiệu báo cáo (*)<br><span class="text-muted">Report No.</span></td>
        <td class="val-col font-bold">{{section1.reportNo}}</td>
      </tr>
      <tr>
        <td class="label-col">Tên công trình<br><span class="text-muted">Building Name</span></td>
        <td class="val-col">
          {{section1.buildingName.vi}}<br>
          <span class="text-muted">{{section1.buildingName.en}}</span>
        </td>
      </tr>
      <tr>
        <td class="label-col">Địa chỉ<br><span class="text-muted">Address</span></td>
        <td class="val-col">
          {{section1.address.vi}}<br>
          <span class="text-muted">{{section1.address.en}}</span>
        </td>
      </tr>
      <tr>
        <td class="label-col">Mã địa chính (*)<br><span class="text-muted">Cadastral code</span></td>
        <td class="val-col font-bold">{{section1.cadastralCode}}</td>
      </tr>
      <tr>
        <td class="label-col">Chủ sở hữu / Người sử dụng<br><span class="text-muted">Owner-Occupant</span></td>
        <td class="val-col">
          {{section1.ownerOccupant.vi}}<br>
          <span class="text-muted">{{section1.ownerOccupant.en}}</span>
        </td>
      </tr>
      <tr>
        <td class="label-col">Số điện thoại liên hệ (*)<br><span class="text-muted">Contact phone</span></td>
        <td class="val-col">{{section1.contactPhone}}</td>
      </tr>
      <tr>
        <td class="label-col">Đơn vị khảo sát<br><span class="text-muted">Survey Consultant</span></td>
        <td class="val-col font-bold">
          {{section1.surveyConsultant.vi}}<br>
          <span class="text-muted">{{section1.surveyConsultant.en}}</span>
        </td>
      </tr>
      <tr>
        <td class="label-col">Nhà thầu EPC (*)<br><span class="text-muted">EPC Contractor</span></td>
        <td class="val-col">{{section1.epcContractor}}</td>
      </tr>
      <tr>
        <td class="label-col">Đoạn tuyến / Khu vực (*)<br><span class="text-muted">Section / Zone</span></td>
        <td class="val-col">
          {{section1.sectionZone.vi}}<br>
          <span class="text-muted">{{section1.sectionZone.en}}</span>
        </td>
      </tr>
      <tr>
        <td class="label-col">Hạng mục Metro liên quan (*)<br><span class="text-muted">Related Metro works</span></td>
        <td class="val-col">
          {{#if section1.relatedMetroWorks.isCutCover}}☒{{else}}☐{{/if}} C&amp;C (Đào hở / Cut-and-Cover) &nbsp;&nbsp;
          {{#if section1.relatedMetroWorks.isBoredTunnel}}☒{{else}}☐{{/if}} POR (Hầm khoan ngầm / Bored/Portal) &nbsp;&nbsp;
          {{#if section1.relatedMetroWorks.isElevated}}☒{{else}}☐{{/if}} ELV (Cầu cạn / Elevated) &nbsp;&nbsp;
          {{#if section1.relatedMetroWorks.isDepot}}☒{{else}}☐{{/if}} DEP (Depot Tham Lương)
        </td>
      </tr>
      <tr>
        <td class="label-col">Tọa độ GPS (*)<br><span class="text-muted">GPS Coordinates</span></td>
        <td class="val-col font-mono">{{section1.gpsCoords.formatted}}</td>
      </tr>
      <tr>
        <td class="label-col">Ngày khảo sát<br><span class="text-muted">Survey Date</span></td>
        <td class="val-col font-bold">{{section1.surveyDate}}</td>
      </tr>
    </table>

    <h2 class="chapter-header">II. THÔNG TIN CƠ BẢN VỀ TÒA NHÀ - BASIC BUILDING INFORMATION</h2>
    <table class="tech-table">
      <tr>
        <td class="label-col">Công năng sử dụng<br><span class="text-muted">Building Use</span></td>
        <td class="val-col">
          {{section2.use.vi}}<br>
          <span class="text-muted">{{section2.use.en}}</span>
        </td>
      </tr>
      <tr>
        <td class="label-col">Số tầng<br><span class="text-muted">Storeys</span></td>
        <td class="val-col">
          {{section2.storeysDisplay.vi}}<br>
          <span class="text-muted">{{section2.storeysDisplay.en}}</span>
        </td>
      </tr>
      <tr>
        <td class="label-col">Diện tích sàn (m²)<br><span class="text-muted">Total floor area</span></td>
        <td class="val-col">
          <strong style="color: #0f3b6c;">{{section2.floorAreaDisplay.vi}}</strong><br>
          <span class="text-muted">{{section2.floorAreaDisplay.en}}</span>
        </td>
      </tr>
      <tr>
        <td class="label-col">Kích thước chính<br><span class="text-muted">Main dimensions</span></td>
        <td class="val-col font-bold">
          {{section2.mainDimensions.vi}}<br>
          <span class="text-muted" style="font-weight: normal;">{{section2.mainDimensions.en}}</span>
        </td>
      </tr>
      <tr>
        <td class="label-col">Chiều cao (m)<br><span class="text-muted">Height</span></td>
        <td class="val-col">
          Cao nhất: {{section2.maxHeightM}} m &nbsp;|&nbsp; Tầng điển hình: {{section2.typicalStoreyHeightM}}<br>
          <span class="text-muted">Max height: {{section2.maxHeightM}} m &nbsp;|&nbsp; Typical storey: {{section2.typicalStoreyHeightM}}</span>
        </td>
      </tr>
      <tr>
        <td class="label-col">Năm xây dựng<br><span class="text-muted">Year constructed</span></td>
        <td class="val-col">
          {{section2.yearConstructed}} {{#if section2.isEstimatedYear}}(Ước tính){{else}}(Xác thực){{/if}}<br>
          <span class="text-muted">{{section2.yearConstructed}} {{#if section2.isEstimatedYear}}(Estimated){{else}}(Verified){{/if}}</span>
        </td>
      </tr>
      <tr>
        <td class="label-col">Khoảng cách đến Metro (m)<br><span class="text-muted">Distance to Metro works</span></td>
        <td class="val-col">
          {{section2.distanceToMetroDisplay.vi}}<br>
          <span class="text-muted">{{section2.distanceToMetroDisplay.en}}</span>
        </td>
      </tr>
      <tr>
        <td class="label-col">Khoảng cách tĩnh không (*)<br><span class="text-muted">Clearance</span></td>
        <td class="val-col">
          <strong style="color: #0f3b6c;">{{section2.clearanceDisplay.vi}}</strong><br>
          <span class="text-muted">{{section2.clearanceDisplay.en}}</span>
        </td>
      </tr>
      <tr>
        <td class="label-col">Nhóm đối tượng khảo sát (*)<br><span class="text-muted">Survey category</span></td>
        <td class="val-col font-bold">
          {{section2.surveyCategory.vi}}<br>
          <span class="text-muted">{{section2.surveyCategory.en}}</span>
        </td>
      </tr>
    </table>

    <div class="page-number-footer">{{tocPageNumbers.section1}}</div>
  </div>

  <!-- =====================================================================
       TRANG 4: CHƯƠNG III & IV (LỊCH SỬ SỬ DỤNG & ĐẶC ĐIỂM KẾT CẤU MÓNG)
       ===================================================================== -->
  <div class="a4-page-sheet">
    
  <div class="report-subpage-topbar">
    <span>LIÊN DANH CRLG – CRSRI – TT | TUYẾN METRO 2 BẾN THÀNH - THAM LƯƠNG</span>
    <span>{{metadata.buildingId}} | {{metadata.reportNo}}</span>
  </div>


    <h2 class="chapter-header">III. LỊCH SỬ VÀ TÌNH TRẠNG SỬ DỤNG - BUILDING HISTORY AND OCCUPANCY</h2>
    <table class="tech-table">
      <tr>
        <td class="label-col">Thay đổi công năng<br><span class="text-muted">Change of use</span></td>
        <td class="val-col">{{section3.changeOfUse.vi}} / <span class="text-muted">{{section3.changeOfUse.en}}</span></td>
      </tr>
      <tr>
        <td class="label-col">Cơi nới / mở rộng<br><span class="text-muted">Extension</span></td>
        <td class="val-col">{{section3.extension.vi}} / <span class="text-muted">{{section3.extension.en}}</span></td>
      </tr>
      <tr>
        <td class="label-col">Cải tạo kết cấu<br><span class="text-muted">Structural alteration</span></td>
        <td class="val-col">{{section3.structuralAlteration.vi}} / <span class="text-muted">{{section3.structuralAlteration.en}}</span></td>
      </tr>
      <tr>
        <td class="label-col">Sửa chữa lớn gần đây<br><span class="text-muted">Major repair</span></td>
        <td class="val-col">{{section3.majorRepair.vi}} / <span class="text-muted">{{section3.majorRepair.en}}</span></td>
      </tr>
      <tr>
        <td class="label-col">Lịch sử hỏa hoạn / ngập lụt<br><span class="text-muted">Fire / Flooding</span></td>
        <td class="val-col">{{section3.fireAndFlooding.vi}}<br><span class="text-muted">{{section3.fireAndFlooding.en}}</span></td>
      </tr>
      <tr>
        <td class="label-col">Lún nghiêng trước đây<br><span class="text-muted">Previous settlement/tilt</span></td>
        <td class="val-col font-bold">{{section3.previousSettlementTilt.vi}} / <span class="text-muted">{{section3.previousSettlementTilt.en}}</span></td>
      </tr>
      <tr>
        <td class="label-col">Tình trạng sử dụng hiện tại<br><span class="text-muted">Occupancy status</span></td>
        <td class="val-col">{{section3.occupancyStatus.vi}} / <span class="text-muted">{{section3.occupancyStatus.en}}</span></td>
      </tr>
      <tr>
        <td class="label-col">Thiết bị nhạy cảm rung động<br><span class="text-muted">Sensitive equipment</span></td>
        <td class="val-col">{{section3.sensitiveEquipment.vi}} / <span class="text-muted">{{section3.sensitiveEquipment.en}}</span></td>
      </tr>
      <tr>
        <td class="label-col">Hư hại do công trình lân cận<br><span class="text-muted">Damage by adjacent works</span></td>
        <td class="val-col">{{section3.damageByAdjacentWorks.vi}} / <span class="text-muted">{{section3.damageByAdjacentWorks.en}}</span></td>
      </tr>
      <tr>
        <td class="label-col">Nguồn thông tin<br><span class="text-muted">Information source</span></td>
        <td class="val-col font-bold">{{section3.informationSource.vi}} / <span class="text-muted font-normal">{{section3.informationSource.en}}</span></td>
      </tr>
    </table>

    <h2 class="chapter-header">IV. ĐẶC ĐIỂM KẾT CẤU VÀ MÓNG - STRUCTURAL AND FOUNDATION CHARACTERISTICS</h2>
    <table class="tech-table">
      <tr>
        <td class="label-col">Loại hình kết cấu<br><span class="text-muted">Structural type</span></td>
        <td class="val-col font-bold">
          {{section4.structuralType.vi}}<br>
