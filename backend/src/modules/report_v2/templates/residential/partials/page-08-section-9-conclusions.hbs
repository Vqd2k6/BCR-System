  <!-- =====================================================================
       TRANG 8: CHƯƠNG IX (KẾT LUẬN VÀ KIẾN NGHỊ)
       ===================================================================== -->
  <div class="a4-page-sheet">
    
  <div class="report-subpage-topbar">
    <span>LIÊN DANH CRLG – CRSRI – TT | TUYẾN METRO 2 BẾN THÀNH - THAM LƯƠNG</span>
    <span>{{metadata.buildingId}} | {{metadata.reportNo}}</span>
  </div>


    <h2 class="chapter-header" data-section="sec-9">IX. KẾT LUẬN VÀ KIẾN NGHỊ - CONCLUSION AND RECOMMENDATION</h2>

    <div style="margin-bottom: 8px;">
      {{#each section9.conclusions}}
        <p>- {{this.vi}}<br><span class="text-muted">- {{this.en}}</span></p>
      {{else}}
        <p>--</p>
      {{/each}}
      {{#if section9.witnessNarrative.vi}}
      <p>- {{section9.witnessNarrative.vi}}<br><span class="text-muted">- {{section9.witnessNarrative.en}}</span></p>
      {{/if}}
    </div>

    <h3 class="section-header">Hạn chế khảo sát / Limitations:</h3>
    {{#if section9.accessAreas.length}}
    <table class="tech-table compact-table" style="margin-bottom: 5px;">
      <thead>
        <tr>
          <th style="width: 28%;">Khu vực công trình / Building Area</th>
          <th style="width: 18%; text-align: center;">Tiếp cận / Accessed</th>
          <th style="width: 54%;">Ghi chú hiện trạng / Field Remarks</th>
        </tr>
      </thead>
      <tbody>
        {{#each section9.accessAreas}}
          <tr>
            <td class="font-bold">
              {{this.area.vi}}<br>
              <span class="text-muted">{{this.area.en}}</span>
            </td>
            <td class="text-center font-bold" style="color: #000000;">
              {{#if this.accessed}}
                <span>☑ Có / Yes</span>
              {{else if this.notAccessed}}
                <span>☒ Không / No</span>
              {{else}}
                <span>– N/A</span>
              {{/if}}
            </td>
            <td>
              {{this.remark.vi}}<br>
              <span class="text-muted">{{this.remark.en}}</span>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}

    {{#if section9.accessClassification.vi}}
    <div style="background-color: transparent; border: 1pt solid #000000; padding: 4px 8px; margin-bottom: 6px; font-size: var(--fs-c1); line-height: 1.35;">
      <strong>Phân loại mức độ tiếp cận (Access Classification):</strong>
      <span style="font-weight: bold; margin-left: 4px; color: #000000;">{{section9.accessClassification.vi}}</span>
      <span class="text-muted" style="margin-left: 4px;">({{section9.accessClassification.en}})</span>
    </div>
    {{/if}}

    <h3 class="section-header">Kiến nghị kỹ thuật / Recommendations:</h3>
    {{#each section9.recommendations}}
      <p>- {{this.vi}}<br><span class="text-muted">- {{this.en}}</span></p>
    {{else}}
      <p>--</p>
    {{/each}}

    {{#if section9.pendingFieldDesignItems.length}}
    <h3 class="section-header">Nội dung cần bổ sung từ hiện trường / thiết kế - Items pending field or design data</h3>
    {{#each section9.pendingFieldDesignItems}}
      <p>- {{this.vi}}<br><span class="text-muted">- {{this.en}}</span></p>
    {{/each}}
    {{/if}}

    <div class="page-number-footer">{{tocPageNumbers.section9}}</div>
  </div>
