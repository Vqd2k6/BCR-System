  <!-- =====================================================================
       TRANG 1: TRANG BÌA BÁO CÁO (COVER PAGE)
       ===================================================================== -->
  <div class="a4-page-sheet">
    
  <!-- HEADER CHUẨN 3 CỘT (LIÊN DANH THACO REC - METRO 2) -->
  <table class="report-running-header">
    <tr>
      <td class="col-logo">
        {{#if metadata.headerLogoBase64}}
          <img src="{{metadata.headerLogoBase64}}" alt="Logo THACO REC">
        {{else}}
          <div style="font-weight: bold; font-size: var(--fs-b1); color: #000000;">THACO REC</div>
        {{/if}}
      </td>
      <td class="col-title">
        <div class="main-title">Ho Chi Minh City Mass Rapid Transit Line2</div>
        <div class="sub-title">Ben Thanh - Tham Luong Route</div>
        <div class="doc-kind">Building Condition Survey and Assessment</div>
      </td>
      <td class="col-meta">
        <strong>Doc.No:</strong> {{metadata.reportNo}}<br>
        <strong>Date:</strong> {{metadata.surveyDateFormatted}}<br>
        <strong>Rev No:</strong> {{metadata.revision}}<br>
        <strong>Page:</strong> 1 of <span id="report-total-pages">{{metadata.totalExpectedPages}}</span>
      </td>
    </tr>
  </table>


    <div class="cover-page-border">
      <!-- TIÊU ĐỀ DỰ ÁN (PROJECT TITLE) -->
      <div class="cover-project-box">
        <div style="font-size: var(--fs-c1); font-weight: bold; color: #000000; margin-bottom: 2px;">
          PROJECT TITLE:
        </div>
        <div style="font-size: var(--fs-b2); font-weight: bold; color: #000000; margin-bottom: 2px;">
          {{metadata.projectTitleVi}}
        </div>
        <div style="font-size: var(--fs-c1); color: #000000; margin-bottom: 2px;">
          {{metadata.projectTitleEn}}
        </div>
        <div style="font-size: var(--fs-c1); font-weight: bold; color: #000000;">
          EPC Contract
        </div>
      </div>

      <!-- TIÊU ĐỀ CHÍNH BÁO CÁO -->
      <div class="cover-doc-title-box">
        <h1>{{metadata.reportTitleVi}}</h1>
        <h2>{{metadata.reportTitleEn}}</h2>
        <div class="cover-id-badge">
          Mã công trình/Building ID: {{metadata.buildingId}}
        </div>
      </div>

      <!-- KHUNG 2 CỘT TRUNG TÂM TRANG BÌA: ẢNH MẶT TIỀN (TRÁI) & SƠ ĐỒ VỊ TRÍ METRO (PHẢI) -->
      <div class="cover-facade-section">
        <div class="cover-facade-grid{{#unless metadata.spatialVisualMapBase64}} cover-single-col{{/unless}}">
          <!-- Cột trái: Ảnh mặt tiền chính -->
          <div class="cover-grid-cell cover-photo-cell">
            <div class="cover-facade-wrapper">
              {{#if metadata.coverPhotoBase64}}
                <img src="{{metadata.coverPhotoBase64}}" class="cover-facade-photo" alt="Ảnh mặt tiền chính công trình">
              {{else if metadata.coverPhotoUrl}}
                <img src="{{metadata.coverPhotoUrl}}" class="cover-facade-photo" alt="Ảnh mặt tiền chính công trình">
              {{else}}
                <div class="photo-placeholder" style="width: 100%; height: 210px; display: flex; align-items: center; justify-content: center;">
                  [ Chưa có ảnh mặt tiền chính ]
                </div>
              {{/if}}
              {{#if (or metadata.coverPhotoBase64 metadata.coverPhotoUrl)}}
                {{#if @root.enableWatermark}}
                  {{#unless metadata.coverAlreadyWatermarked}}
                    {{#if metadata.headerLogoBase64}}
                      <img src="{{metadata.headerLogoBase64}}" class="watermark-logo-top-right watermark-logo-sm" alt="THACO REG">
                    {{/if}}
                    <div class="watermark-text-bottom-right watermark-text-sm">
                      <div class="watermark-datetime">{{#if metadata.coverWatermarkDateTime}}{{metadata.coverWatermarkDateTime}}{{else}}{{metadata.watermarkDateTime}}{{/if}}</div>
                      <div class="watermark-code">HCM_M2.[{{metadata.buildingId}}]_P02_MAIN</div>
                    </div>
                  {{/unless}}
                {{/if}}
              {{/if}}
            </div>
            <div class="cover-sub-caption">ẢNH MẶT TIỀN CÔNG TRÌNH / FACADE PHOTO</div>
          </div>

          <!-- Cột phải: Sơ đồ vị trí không gian Metro (Nếu có) -->
          {{#if metadata.spatialVisualMapBase64}}
          <div class="cover-grid-cell cover-map-cell">
            <div class="cover-spatial-wrapper">
              <img src="{{metadata.spatialVisualMapBase64}}" class="cover-spatial-img" alt="Sơ đồ vị trí không gian Metro 2">
            </div>
            <div class="cover-sub-caption">SƠ ĐỒ VỊ TRÍ THỬA ĐẤT &amp; TUYẾN METRO 2 / SPATIAL MAP</div>
          </div>
          {{/if}}
        </div>
      </div>

      <!-- ĐỊA CHỈ VÀ THỜI GIAN KHẢO SÁT -->
      <div class="cover-address-section">
        ĐỊA CHỈ: {{section1.address.vi}}<br>
        ADD: {{section1.address.en}}
      </div>

      <div class="cover-time-section">
        THỜI GIAN/TIME: {{metadata.surveyDateFormatted}}
      </div>

      <!-- BẢNG KÝ DUYỆT 3 BÊN -->
      <table class="signature-table">
        <thead>
          <tr>
            {{#each signatures3Party}}
              <th>{{this.roleVi}}<br><span style="font-size: var(--fs-f1); font-weight: normal;">{{this.roleEn}}</span></th>
            {{/each}}
          </tr>
        </thead>
        <tbody>
          <tr>
            {{#each signatures3Party}}
              <td>
                <div style="font-size: var(--fs-f1); color: #000000; margin-bottom: 2px;">HỌ TÊN / FULL NAME</div>
                <div class="font-bold" style="font-size: var(--fs-c1); color: #000000; min-height: 14px; margin-bottom: 2px;">
                  {{#if this.fullName}}{{this.fullName}}{{else}}&nbsp;{{/if}}
                </div>
                <div style="font-size: var(--fs-f1); color: #000000; margin-bottom: 4px;">{{this.titleVi}}</div>
                
                <div style="font-size: var(--fs-f1); color: #000000; margin-bottom: 2px;">CHỮ KÝ / SIGNATURE</div>
                <div class="signature-box">
                  {{#if this.signatureBase64}}
                    <img src="{{this.signatureBase64}}" alt="Chữ ký">
                  {{else if this.signatureUrl}}
                    <img src="{{this.signatureUrl}}" alt="Chữ ký">
                  {{/if}}
                </div>

                <div style="font-size: var(--fs-f1); color: #000000; font-weight: bold; border-top: 1px dotted #000000; padding-top: 4px;">
                  NGÀY / DATE: {{#if this.date}}{{this.date}}{{else}}&nbsp;{{/if}}
                </div>
              </td>
            {{/each}}
          </tr>
        </tbody>
      </table>
    </div>

    <div class="page-number-footer">1</div>
  </div>
