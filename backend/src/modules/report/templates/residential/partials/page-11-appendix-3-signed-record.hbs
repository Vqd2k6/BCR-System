<!-- =====================================================================
       MỤC XI: BIÊN BẢN KHẢO SÁT HIỆN TRƯỜNG ĐÃ KÝ
       ===================================================================== -->
<div class="a4-page-sheet">
  <div class="report-subpage-topbar">
    <span>LIÊN DANH CRLG – CRSRI – TT | TUYẾN METRO 2 BẾN THÀNH - THAM LƯƠNG</span>
    <span>{{metadata.buildingId}} | {{metadata.reportNo}}</span>
  </div>

  <h2 class="chapter-header" data-section="sec-xi">XI. BIÊN BẢN KHẢO SÁT HIỆN TRƯỜNG</h2>
  <div style="font-size: var(--fs-c1); font-weight: bold; color: var(--c-sub); margin-bottom: 6px;">
    SECTION XI: SIGNED SITE-SURVEY RECORD
  </div>

  <table class="tech-table">
    <tr>
      <td class="label-col">Địa chỉ công trình<br><span class="text-muted">Building address</span></td>
      <td class="val-col">{{appendix3.address.vi}}</td>
    </tr>
    <tr>
      <td class="label-col">Thời gian lập biên bản<br><span class="text-muted">Record time</span></td>
      <td class="val-col font-bold">{{appendix3.surveyTime}}</td>
    </tr>
    <tr>
      <td class="label-col">Đại diện chủ sở hữu<br><span class="text-muted">Owner representative</span></td>
      <td class="val-col">{{appendix3.ownerRepresentative.vi}}</td>
    </tr>
    <tr>
      <td class="label-col">Số điện thoại liên hệ<br><span class="text-muted">Contact phone</span></td>
      <td class="val-col">{{appendix3.contactPhone}}</td>
    </tr>
    <tr>
      <td class="label-col">Chính quyền địa phương<br><span class="text-muted">Local authority</span></td>
      <td class="val-col">{{appendix3.localAuthority.vi}}</td>
    </tr>
    <tr>
      <td class="label-col">Đơn vị tư vấn giám sát<br><span class="text-muted">Supervision consultant</span></td>
      <td class="val-col">{{appendix3.supervisionConsultant.vi}}</td>
    </tr>
    <tr>
      <td class="label-col">Đơn vị khảo sát<br><span class="text-muted">Survey unit</span></td>
      <td class="val-col font-bold">{{appendix3.surveyUnit.vi}}</td>
    </tr>
    <tr>
      <td class="label-col">Ý kiến ghi nhận tại chỗ<br><span class="text-muted">Field comments</span></td>
      <td class="val-col">{{appendix3.fieldComments.vi}}</td>
    </tr>
  </table>
</div>

{{#if appendix3.signedRecordPages.length}}
{{#each appendix3.signedRecordPages}}
<div class="a4-page-sheet">
  <div class="report-subpage-topbar">
    <span>LIÊN DANH CRLG – CRSRI – TT | TUYẾN METRO 2 BẾN THÀNH - THAM LƯƠNG</span>
    <span>{{../metadata.buildingId}} | {{../metadata.reportNo}}</span>
  </div>

  <h2 class="chapter-header">XI. BẢN GỐC BIÊN BẢN HIỆN TRƯỜNG CÓ CHỮ KÝ PHÁP LÝ</h2>
  <div style="font-size: var(--fs-c1); font-weight: bold; color: var(--c-sub); margin-bottom: 8px;">
    SECTION XI: LEGAL SIGNED WORKING MINUTES (Page {{this.pageIndex}})
  </div>

  <div style="text-align: center; margin: 6px 0;">
    <div class="signed-record-img-wrapper"
      style="position: relative; display: inline-block; max-width: 100%; margin: 0 auto;">
      {{#if @root.isPiiMasked}}
      {{#if this.base64}}
      <img src="{{this.base64}}" alt="{{this.title.vi}}"
        style="height: 205mm; max-width: 100%; object-fit: contain; border: 1px solid #000000; display: block; margin: 0 auto; filter: blur(6px); opacity: 0.65; pointer-events: none;">
      {{else if this.url}}
      <img src="{{this.url}}" alt="{{this.title.vi}}"
        style="height: 205mm; max-width: 100%; object-fit: contain; border: 1px solid #000000; display: block; margin: 0 auto; filter: blur(6px); opacity: 0.65; pointer-events: none;">
      {{else}}
      <div class="photo-placeholder" style="height: 205mm;">[ Chưa có ảnh biên bản trang {{this.pageIndex}} ]</div>
      {{/if}}
      <div
        style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(0, 0, 0, 0.88); color: #fff; padding: 16px 24px; border-radius: 4px; border: 1px solid rgba(255,255,255,0.3); backdrop-filter: blur(4px); box-shadow: 0 4px 16px rgba(0,0,0,0.35); text-align: center; max-width: 82%; width: 440px;">
        <div style="font-size: var(--fs-b2); font-weight: bold; margin-bottom: 6px; color: #ffffff; letter-spacing: 0.5px;">
          BẢO MẬT THÔNG TIN CÁ NHÂN (PII MASKED)
        </div>
        <div style="font-size: var(--fs-c1); color: #f1f5f9; line-height: 1.45;">
          Bản quét biên bản hiện trường chứa thông tin định danh &amp; chữ ký tay của chủ sở hữu công trình đã được làm
          mờ bảo mật theo Nghị định 13/2023/NĐ-CP.
        </div>
      </div>
      {{else}}
      {{#if this.base64}}
      <img src="{{this.base64}}" alt="{{this.title.vi}}"
        style="height: 205mm; max-width: 100%; object-fit: contain; border: 1px solid #000000; display: block; margin: 0 auto;">
      {{else if this.url}}
      <img src="{{this.url}}" alt="{{this.title.vi}}"
        style="height: 205mm; max-width: 100%; object-fit: contain; border: 1px solid #000000; display: block; margin: 0 auto;">
      {{else}}
      <div class="photo-placeholder" style="height: 205mm;">[ Chưa có ảnh biên bản trang {{this.pageIndex}} ]</div>
      {{/if}}
      {{/if}}
    </div>
  </div>
  <div class="photo-caption text-center font-bold" style="margin-top: 4px;">
    {{this.title.vi}}
  </div>
</div>
{{/each}}
{{/if}}