      <td>{{angularDistortion}}</td>
    </tr>
    <tr>
      <th>Vận tốc hạt đỉnh rung động (PPV)</th>
      <td>{{vibrationPpv}} mm/s</td>
      <th>Cấp tác động Metro (Impact Class I)</th>
      <td class="font-bold"><span class="badge {{impactBadgeClass}}">CẤP I-{{constructionImpactLevelI}}</span></td>
    </tr>
  </table>

  <h2 class="section-header">12. SÀNG LỌC MA TRẬN RỦI RO CƠ SỞ (BUILDING RISK ASSESSMENT - BRA)</h2>
  <table class="tech-table">
    <thead>
      <tr>
        <th style="width: 22%;">Vulnerability (VI) ↓ \ Impact (I) &rarr;</th>
        <th class="text-center" style="width: 18%;">I1 (Thấp)</th>
        <th class="text-center" style="width: 18%;">I2 (Trung bình)</th>
        <th class="text-center" style="width: 18%;">I3 (Cao)</th>
        <th class="text-center" style="width: 18%;">I4 (Rất cao)</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="font-bold">V1 (Thấp)</td>
        <td class="text-center">Thấp</td>
        <td class="text-center">Thấp</td>
        <td class="text-center">Trung bình</td>
        <td class="text-center">Cao</td>
      </tr>
      <tr>
        <td class="font-bold">V2 (Trung bình)</td>
        <td class="text-center">Thấp</td>
        <td class="text-center">Trung bình</td>
        <td class="text-center">Trung bình</td>
        <td class="text-center">Cao</td>
      </tr>
      <tr>
        <td class="font-bold">V3 (Cao)</td>
        <td class="text-center">Trung bình</td>
        <td class="text-center">Trung bình</td>
        <td class="text-center">Cao</td>
        <td class="text-center">Rất cao</td>
      </tr>
      <tr>
        <td class="font-bold">V4 (Rất cao)</td>
        <td class="text-center">Cao</td>
        <td class="text-center">Cao</td>
        <td class="text-center">Rất cao</td>
        <td class="text-center">Rất cao</td>
      </tr>
    </tbody>
  </table>

  <table class="tech-table" style="margin-top: 8px;">
    <tr>
      <th style="width: 25%;">Kết quả giao điểm rủi ro:</th>
      <td class="font-bold" style="font-size: 11pt; color: #b91c1c; width: 35%;">
        BRA = {{buildingRiskAssessmentBra}}
      </td>
      <th style="width: 15%;">Giao điểm:</th>
      <td>VI: {{viClass}} &times; Cấp I-{{constructionImpactLevelI}}</td>
    </tr>
    <tr>
      <th>Hành động bắt buộc:</th>
      <td colspan="3" class="font-bold">{{braMandatoryAction}}</td>
    </tr>
  </table>

  {{#if braEngineeringReviewNotes}}
  <div class="note-box">
    <div class="note-title">🛡️ Ý kiến chuyên gia rà soát rủi ro BRA:</div>
    {{braEngineeringReviewNotes}}
  </div>
  {{/if}}

  <h2 class="section-header">13. KẾT LUẬN VÀ KIẾN NGHỊ KỸ THUẬT</h2>
  
  <div style="font-size: 9pt; margin-bottom: 8px;">
    <strong>Tóm tắt kết luận hiện trạng:</strong>
    <p style="margin: 2px 0 6px 0; text-align: justify;">{{summaryConclusions}}</p>
  </div>

  <div style="font-size: 9pt; margin-bottom: 8px;">
    <strong>Kiến nghị kỹ thuật bảo vệ & quan trắc:</strong>
    <p style="margin: 2px 0 6px 0; text-align: justify;">{{engineeringRecommendations}}</p>
  </div>

  <!-- NƠI HIỂN THỊ Ý KIẾN VÀ GHI CHÚ PHẢN ÁNH CỦA CHỦ NHÀ -->
  <div class="note-box" style="background-color: #f0fdf4; border-left-color: #16a34a;">
    <div class="note-title">🗣️ Ý kiến, yêu cầu và ghi chú bảo lưu của Chủ sở hữu / Người sử dụng:</div>
    <div style="font-style: italic; color: #166534; font-size: 9pt;">
      {{#if ownerRemarks}}"{{ownerRemarks}}"{{else}}"Chủ nhà thống nhất với toàn bộ số liệu và hình ảnh khuyết tật do đoàn khảo sát ghi nhận tại hiện trường, không có khiếu nại hoặc bổ sung thêm."{{/if}}
    </div>
  </div>

  <!-- =====================================================================
       PHỤ LỤC F: BIÊN BẢN LÀM VIỆC HIỆN TRƯỜNG & CHỮ KÝ 3 BÊN
       ===================================================================== -->
  <div class="page-break"></div>

  <h2 class="section-header">PHỤ LỤC F: BIÊN BẢN LÀM VIỆC HIỆN TRƯỜNG & CHỮ KÝ PHÁP LÝ</h2>

  {{#if fieldWorkMinutesPhotoUrl}}
  <div style="text-align: center; margin: 10px 0; border: 1pt solid #cbd5e1; padding: 6px; background-color: #f8fafc;">
    <img src="{{fieldWorkMinutesPhotoUrl}}" alt="Biên bản hiện trường viết tay" style="max-width: 100%; max-height: 480px; object-fit: contain;">
    <div style="font-size: 8pt; font-weight: bold; color: #475569; margin-top: 4px;">
      HÌNH F.1: BIÊN BẢN LÀM VIỆC KHẢO SÁT HIỆN TRƯỜNG KÝ XÁC NHẬN TẠI CHỖ (BẢN GỐC)
    </div>
  </div>
  {{/if}}

  <!-- KHUNG CHỮ KÝ 3 BÊN -->
  <div class="signature-grid">
    <div class="sig-box">
      <div class="sig-role">KHẢO SÁT VIÊN HIỆN TRƯỜNG</div>
      <div>
        {{#if surveyorSignatureUrl}}
          <img src="{{surveyorSignatureUrl}}" alt="Chữ ký khảo sát viên" class="sig-img">
        {{else}}
          <div style="height: 50px; line-height: 50px; color: #94a3b8; font-size: 8pt;">(Đã ký xác nhận)</div>
        {{/if}}
      </div>
      <div>
        <div class="sig-name">{{preparedByName}}</div>
        <div class="sig-date">Ngày: {{surveyDate}}</div>
      </div>
    </div>

    <div class="sig-box">
      <div class="sig-role">CHỦ SỞ HỮU / ĐẠI DIỆN CÔNG TRÌNH</div>
      <div>
        {{#if ownerSignatureUrl}}
          <img src="{{ownerSignatureUrl}}" alt="Chữ ký chủ nhà" class="sig-img">
        {{else}}
          <div style="height: 50px; line-height: 50px; color: #94a3b8; font-size: 8pt;">(Đã ký xác nhận)</div>
        {{/if}}
      </div>
      <div>
        <div class="sig-name">{{ownerName}}</div>
        <div class="sig-date">Ngày: {{surveyDate}}</div>
      </div>
    </div>

    <div class="sig-box">
      <div class="sig-role">GIÁM SÁT / PHÊ DUYỆT (ZONE ADMIN)</div>
      <div>
        {{#if zoneAdminSignatureUrl}}
          <img src="{{zoneAdminSignatureUrl}}" alt="Chữ ký Zone Admin" class="sig-img">
        {{else}}
          <div style="height: 50px; line-height: 50px; color: #94a3b8; font-size: 8pt;">(Đã ký số)</div>
        {{/if}}
      </div>
      <div>
        <div class="sig-name">{{approvedByName}}</div>
        <div class="sig-date">Ngày: {{surveyDate}}</div>
      </div>
    </div>
  </div>

  <!-- MÃ TRA CỨU QR & BẢO MẬT CHECKSUM SHA-256 -->
  <div style="margin-top: 20px; border-top: 0.5pt solid #cbd5e1; padding-top: 10px; display: flex; justify-content: space-between; align-items: center; font-size: 7.5pt; color: #64748b;">
    <div>
      <div><strong>Mã băm toàn vẹn hồ sơ (SHA-256 Checksum):</strong></div>
      <div style="font-family: monospace; color: #0f172a; word-break: break-all;">{{sha256Checksum}}</div>
      <div style="margin-top: 2px;">Thời điểm xuất báo cáo: {{generatedAt}} | Hệ thống Quản lý Khảo sát Metro 2 TP.HCM</div>
    </div>
    <div style="text-align: center; margin-left: 15px;">
      <div style="border: 0.5pt solid #94a3b8; padding: 2px; background: #fff; width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; font-size: 7pt; color: #0f3b6c; font-weight: bold;">
        [ QR TRA CỨU ]
      </div>
      <div style="font-size: 6.5pt; color: #475569; margin-top: 1px;">Tra cứu hồ sơ</div>
    </div>
  </div>

</body>
</html>
