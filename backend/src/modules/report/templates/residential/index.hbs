          | Cấu kiện: {{componentType}} | Cấp Burland: Cấp {{burlandGrade}} ({{burlandLabel}})
          {{#if functionalImpactRepairNeeded}} | <span style="color: #c2410c; font-weight: bold;">[Cần sửa chữa công năng]</span>{{/if}}
        </div>

        {{#if notes}}
        <div style="font-size: 8pt; color: #334155; margin-bottom: 4px; padding-left: 6px;">
          <em>Ghi chú vùng: {{notes}}</em>
        </div>
        {{/if}}

        <!-- HIỂN THỊ CÁC THẺ KHUYẾT TẬT D DẠNG CẶP ẢNH ĐỐI CHIẾU -->
        {{#each defects}}
        <div class="defect-card">
          <div class="defect-header">
            <div>VẾT NỨT: {{defectCode}} ({{roomName}} - {{componentType}})</div>
            <div>Trạng thái: {{activityStateLabel}} | Cấp Burland: {{burlandGrade}}</div>
          </div>
          <div class="defect-body">
            <!-- Thông số kỹ thuật -->
            <div class="defect-params">
              <table>
                <tr>
                  <td style="color: #64748b; width: 45%;">Bề rộng max:</td>
                  <td class="font-bold" style="color: #b91c1c;">{{widthMaxMm}} mm</td>
                </tr>
                <tr>
                  <td style="color: #64748b;">Chiều dài:</td>
                  <td>{{lengthMm}} mm</td>
                </tr>
                <tr>
                  <td style="color: #64748b;">Phương nứt:</td>
                  <td>{{crackDirection}}</td>
                </tr>
                <tr>
                  <td style="color: #64748b;">Ý nghĩa kết cấu:</td>
                  <td class="font-bold">{{structuralSignificanceLabel}}</td>
                </tr>
                <tr>
                  <td style="color: #64748b;">Thước đo nứt:</td>
                  <td>{{#if hasScaleCard}}Đã đặt thước chuẩn{{else}}<span style="color: #dc2626;">Không có thước</span>{{/if}}</td>
                </tr>
                <tr>
                  <td style="color: #64748b;">Cảnh báo:</td>
                  <td>{{#if isStructuralCritical}}<span class="badge badge-critical">NỨT NGUY HIỂM</span>{{else}}Bình thường{{/if}}</td>
                </tr>
              </table>
              {{#if notes}}
              <div style="margin-top: 4px; font-size: 7.5pt; color: #475569;">
                <strong>Ghi chú:</strong> {{notes}}
              </div>
              {{/if}}
            </div>

            <!-- Ảnh bối cảnh toàn cảnh -->
            <div class="defect-photo-box">
              {{#if ctxPhotoUrl}}
