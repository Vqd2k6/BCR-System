<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>BÁO CÁO KHẢO SÁT HIỆN TRẠNG CÔNG TRÌNH - {{reportCode}}</title>
  <style>
    {{{styles}}}
  </style>
</head>
<body>

  <!-- =====================================================================
       TRANG BÌA (COVER PAGE)
       ===================================================================== -->
  <div class="cover-page">
    <div class="cover-header">
      <div class="joint-venture">LIÊN DANH CRLG–CRSRI–TT</div>
      <div class="project-name">
        DỰ ÁN XÂY DỰNG TUYẾN ĐƯỜNG SẮT ĐÔ THỊ SỐ 2 TP. HỒ CHÍ MINH<br>
        (BẾN THÀNH – THAM LƯƠNG)
      </div>
    </div>

    <div style="text-align: center; margin: 12px 0;">
      <h1 class="doc-title">BÁO CÁO KHẢO SÁT HIỆN TRẠNG CÔNG TRÌNH – PHASE 1</h1>
      <h2 class="doc-subtitle">BUILDING CONDITION SURVEY REPORT – PHASE 1</h2>
    </div>

    <!-- ẢNH ĐỊNH DANH NGOẠI THẤT P-02 TRÊN TRANG BÌA -->
    <div class="cover-photo">
      {{#if p02.url}}
        <img src="{{p02.url}}" alt="Mặt đứng chính công trình">
      {{else}}
        <div style="height: 220px; display: flex; align-items: center; justify-content: center; background: #e2e8f0; color: #64748b;">
          [ Chưa có ảnh mặt đứng chính P-02 ]
        </div>
      {{/if}}
      <div style="font-size: 8pt; color: #475569; margin-top: 3px;">
        ẢNH MẶT ĐỨNG CÔNG TRÌNH / BUILDING FRONTAGE PHOTO (P-02)
      </div>
    </div>

    <!-- BẢNG ĐỊNH DANH BÌA -->
    <table class="cover-meta-table">
      <tr>
        <td class="label">Mã công trình (Building ID)</td>
        <td class="font-bold">{{buildingId}}</td>
        <td class="label">Mã khảo sát (Survey ID)</td>
        <td>{{surveyId}}</td>
      </tr>
      <tr>
        <td class="label">Địa chỉ công trình</td>
        <td colspan="3">{{address}}</td>
      </tr>
      <tr>
        <td class="label">Đoạn tuyến / Phân khu</td>
        <td>{{zoneName}} ({{zoneId}})</td>
        <td class="label">Hạng mục Metro gần nhất</td>
        <td>{{metroItemType}}</td>
      </tr>
      <tr>
        <td class="label">Cự ly đến tim hầm</td>
        <td>{{distanceToTunnelMeters}} m (Lý trình: {{chainage}})</td>
        <td class="label">Ngày khảo sát</td>
        <td>{{surveyDate}}</td>
      </tr>
      <tr>
        <td class="label">Chủ sở hữu / Người sử dụng</td>
        <td>{{ownerName}}</td>
        <td class="label">Số hiệu tài liệu / Phiên bản</td>
        <td>{{reportCode}} (Rev. {{revision}})</td>
      </tr>
    </table>

    <div class="cover-footer">
      THÀNH PHỐ HỒ CHÍ MINH, NĂM 2026
    </div>
  </div>

  <!-- =====================================================================
       TRANG 2: KIỂM SOÁT TÀI LIỆU & DASHBOARD CHỈ SỐ RỦI RO
       ===================================================================== -->
  <div class="page-break"></div>

  <h2 class="section-header">KIỂM SOÁT TÀI LIỆU / DOCUMENT CONTROL</h2>
  <table class="tech-table">
    <tr>
      <th style="width: 25%;">Tên dự án</th>
      <td colspan="3">Xây dựng Tuyến Đường sắt đô thị số 2 TP.HCM (Bến Thành – Tham Lương)</td>
    </tr>
    <tr>
      <th>Tên tài liệu</th>
      <td>Báo cáo khảo sát hiện trạng công trình – Phase 1 (Baseline Report)</td>
      <th style="width: 20%;">Số tài liệu</th>
      <td>{{reportCode}}</td>
    </tr>
    <tr>
      <th>Đơn vị thực hiện</th>
      <td>Liên danh CRLG–CRSRI–TT</td>
      <th>Nhà thầu EPC</th>
      <td>THACO-CREC</td>
    </tr>
    <tr>
      <th>Mã thửa đất (Building ID)</th>
      <td class="font-bold">{{buildingId}}</td>
      <th>Mã địa chính</th>
      <td>{{officialCadastralCode}}</td>
    </tr>
    <tr>
      <th>Địa chỉ thực tế</th>
      <td colspan="3">{{address}}</td>
    </tr>
  </table>

  <!-- BẢNG THEO DÕI SỬA ĐỔI PHÁT HÀNH -->
  <table class="tech-table">
    <thead>
      <tr>
        <th class="text-center" style="width: 8%;">Rev.</th>
        <th class="text-center" style="width: 15%;">Ngày</th>
        <th>Mô tả phát hành</th>
        <th class="text-center" style="width: 18%;">Lập báo cáo</th>
        <th class="text-center" style="width: 18%;">Kiểm tra</th>
        <th class="text-center" style="width: 18%;">Phê duyệt</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="text-center">{{revision}}</td>
        <td class="text-center">{{surveyDate}}</td>
        <td>Phát hành hồ sơ khảo sát hiện trạng công trình trước thi công Metro</td>
        <td class="text-center">{{preparedByName}}</td>
        <td class="text-center">{{checkedByName}}</td>
        <td class="text-center">{{approvedByName}}</td>
      </tr>
    </tbody>
  </table>

  <div class="note-box">
    <div class="note-title">📌 Ghi chú pháp lý tài liệu:</div>
    Báo cáo Phase 1 là hồ sơ kỹ thuật khảo sát và sàng lọc rủi ro ban đầu. Hồ sơ pháp lý xác nhận hiện trạng trước thi công được lưu trữ trong Cơ sở dữ liệu Dự án Metro 2 và làm căn cứ pháp lý đối soát giải quyết bồi hoàn/khiếu nại nếu có phát sinh ảnh hưởng lún nứt trong quá trình thi công đào hầm TBM.
  </div>

  <!-- BẢNG ĐIỀU KHIỂN CHỈ SỐ RỦI RO (EXECUTIVE RISK DASHBOARD) -->
  <h2 class="section-header" style="margin-top: 20px;">TỔNG QUAN CHỈ SỐ RỦI RO CÔNG TRÌNH (EXECUTIVE DASHBOARD)</h2>
  
  <div class="dashboard-grid">
    <div class="metric-card">
      <div class="metric-label">Tình trạng hiện hữu (ECS)</div>
      <div class="metric-value">{{totalEcsScore}} <span style="font-size: 9pt; color: #64748b;">/ 24</span></div>
      <div style="margin-top: 4px;">
        <span class="badge {{ecsBadgeClass}}">{{ecsClass}}</span>
      </div>
      <div class="metric-desc">Thang điểm 6 tiêu chí E1-E6</div>
    </div>

    <div class="metric-card">
      <div class="metric-label">Chỉ số dễ tổn thương (VI)</div>
      <div class="metric-value">{{avgViScore}} <span style="font-size: 9pt; color: #64748b;">/ 4.0</span></div>
      <div style="margin-top: 4px;">
        <span class="badge {{viBadgeClass}}">{{viClass}}</span>
      </div>
      <div class="metric-desc">Mức nhạy cảm với biến dạng</div>
    </div>

    <div class="metric-card">
      <div class="metric-label">Cấp tác động Metro (I)</div>
      <div class="metric-value">CẤP I-{{constructionImpactLevelI}}</div>
      <div style="margin-top: 4px;">
        <span class="badge {{impactBadgeClass}}">CỰ LY {{distanceToTunnelMeters}}M</span>
      </div>
      <div class="metric-desc">Khoảng cách đến tim hầm</div>
    </div>

    <div class="metric-card">
      <div class="metric-label">Sàng lọc rủi ro (BRA)</div>
      <div class="metric-value" style="font-size: 11pt;">{{buildingRiskAssessmentBra}}</div>
      <div style="margin-top: 4px;">
        <span class="badge {{braBadgeClass}}">MA TRẬN V × I</span>
      </div>
      <div class="metric-desc">Hành động tối thiểu tương ứng</div>
    </div>
  </div>

  <table class="tech-table">
    <tr>
      <th style="width: 25%;">Dự báo lún tối đa ($S_{\text{max}}$)</th>
      <td style="width: 25%;">{{predictedSettlementSmax}} mm</td>
      <th style="width: 25%;">Độ võng dầm / sàn lớn nhất</th>
      <td style="width: 25%;">{{beamDeflectionMm}} mm</td>
    </tr>
    <tr>
      <th>Độ nghiêng công trình ($X / Y$)</th>
      <td>{{tiltAngleX}} ‰ / {{tiltAngleY}} ‰ ({{tiltDirection}})</td>
      <th>Tổng số vết nứt ghi nhận</th>
      <td class="font-bold">{{totalDefectsCount}} vết nứt ({{totalDamageZonesCount}} vùng)</td>
    </tr>
  </table>

  <!-- =====================================================================
       MỤC 1 & 2: THÔNG TIN DỰ ÁN & PHƯƠNG PHÁP KHẢO SÁT
       ===================================================================== -->
  <h2 class="section-header">1. THÔNG TIN CHUNG DỰ ÁN & VỊ TRÍ CÔNG TRÌNH</h2>
  <p style="font-size: 9pt; margin: 4px 0 8px 0; text-align: justify;">
    Dự án Xây dựng Tuyến Đường sắt đô thị số 2 TP.HCM (Bến Thành – Tham Lương) được triển khai qua các trục đường đô thị có mật độ công trình dày đặc. Công tác khảo sát hiện trạng Phase 1 nhằm thiết lập bộ hồ sơ hiện trạng kỹ thuật ban đầu (Baseline Condition) phục vụ sàng lọc rủi ro BRA và làm căn cứ bảo vệ quyền lợi hợp pháp của người dân cũng như Chủ đầu tư.
  </p>

  <table class="tech-table">
    <tr>
      <th style="width: 25%;">Nhà thầu EPC</th>
      <td>THACO-CREC</td>
      <th style="width: 25%;">Đơn vị khảo sát</th>
      <td>Liên danh CRLG–CRSRI–TT</td>
    </tr>
    <tr>
      <th>Đoạn tuyến / Ga phụ trách</th>
      <td>{{zoneName}}</td>
      <th>Hạng mục công trình Metro</th>
      <td>{{metroItemType}}</td>
    </tr>
    <tr>
      <th>Lý trình tim tuyến (Chainage)</th>
      <td>{{chainage}}</td>
      <th>Cự ly từ ranh đất đến tim hầm</th>
      <td class="font-bold">{{distanceToTunnelMeters}} mét</td>
    </tr>
  </table>

  <h2 class="section-header">2. MỤC ĐÍCH, PHẠM VI VÀ THIẾT BỊ KHẢO SÁT</h2>
  <table class="tech-table">
    <thead>
      <tr>
        <th class="text-center" style="width: 8%;">STT</th>
        <th style="width: 35%;">Thiết bị / Công cụ đo đạc</th>
        <th style="width: 25%;">Thông số kỹ thuật</th>
        <th>Mục đích sử dụng</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="text-center">1</td>
        <td class="font-bold">Thiết bị chụp ảnh số có gắn GPS</td>
        <td>Độ phân giải &ge; 12MP, gắn EXIF tọa độ</td>
        <td>Chụp ảnh định danh và bối cảnh vết nứt</td>
      </tr>
      <tr>
        <td class="text-center">2</td>
        <td class="font-bold">Thước đo bề rộng vết nứt (Crack Gauge)</td>
        <td>Thước chuẩn vạch chia từ 0.1mm đến 5.0mm</td>
        <td>Đo bề rộng lớn nhất ($w_{\text{max}}$) của khuyết tật</td>
      </tr>
      <tr>
        <td class="text-center">3</td>
        <td class="font-bold">Thước đo khoảng cách Laser / Thước thép</td>
        <td>Sai số &plusmn; 1.5mm, tầm đo 40m</td>
        <td>Đo chiều dài vết nứt và kích thước phòng</td>
      </tr>
      <tr>
        <td class="text-center">4</td>
        <td class="font-bold">Thiết bị đo nghiêng kỹ thuật số (Laser Level)</td>
        <td>Độ chính xác 0.1&permil;</td>
        <td>Đo độ nghiêng tường và độ dốc sàn dầm</td>
      </tr>
    </tbody>
  </table>

  <!-- =====================================================================
       MỤC 3: THÔNG TIN VÀ ĐẶC ĐIỂM CÔNG TRÌNH (KÈM LỊCH SỬ SỬ DỤNG)
       ===================================================================== -->
  <div class="page-break"></div>

  <h2 class="section-header">3. THÔNG TIN VÀ ĐẶC ĐIỂM CÔNG TRÌNH</h2>

  <h3 class="subsection-header">3.1. Thông tin nhận dạng & quy mô kết cấu</h3>
  <table class="tech-table">
    <tr>
      <th style="width: 22%;">Tên công trình</th>
      <td style="width: 28%;">{{buildingName}}</td>
      <th style="width: 22%;">Chủ sở hữu / Người sử dụng</th>
      <td style="width: 28%;">{{ownerName}}</td>
    </tr>
    <tr>
      <th>Địa chỉ công trình</th>
      <td colspan="3">{{address}}</td>
    </tr>
    <tr>
      <th>Công năng hiện hữu</th>
      <td>{{landUseFunction}}</td>
      <th>Số tầng công trình</th>
      <td>Nổi: {{floorCount}} tầng | Hầm: {{basementCount}} hầm</td>
    </tr>
    <tr>
      <th>Hệ kết cấu chịu lực</th>
      <td class="font-bold">{{structuralSystemLabel}}</td>
      <th>Năm xây dựng</th>
      <td>{{yearOfConstruction}} {{#if isYearEstimated}}(Ước tính){{/if}}</td>
    </tr>
    <tr>
      <th>Loại móng</th>
      <td class="font-bold">{{foundationCategoryLabel}}</td>
      <th>CAT thông tin móng</th>
      <td>{{foundationCategory}} (Nguồn: {{foundationInfoSource}})</td>
    </tr>
    <tr>
      <th>Diện tích xây dựng</th>
      <td>{{constructionAreaM2}} m²</td>
      <th>Chiều cao ước tính</th>
      <td>{{estimatedHeightM}} m</td>
    </tr>
    <tr>
      <th>Công trình tiếp giáp lân cận</th>
      <td colspan="3">{{adjacentBuildingsNote}}</td>
    </tr>
  </table>

  <!-- 3.2. LỊCH SỬ SỬ DỤNG VÀ CÁC YẾU TỐ NHẠY CẢM (CÁC NOTE PHÁT SINH) -->
  <h3 class="subsection-header">3.2. Lịch sử sử dụng và các yếu tố nhạy cảm (Ghi chú khảo sát)</h3>
  <table class="tech-table">
    <thead>
      <tr>
        <th style="width: 32%;">Nội dung kiểm tra</th>
        <th class="text-center" style="width: 14%;">Hiện trạng</th>
        <th>Ghi chú chi tiết phát sinh tại hiện trường</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="font-bold">Cơi nới / Thay đổi tải trọng / Nâng tầng</td>
        <td class="text-center">{{#if extendedOrRenovated}}<span style="color: #c2410c; font-weight: bold;">CÓ</span>{{else}}KHÔNG{{/if}}</td>
        <td>{{#if extendedOrRenovatedNotes}}{{extendedOrRenovatedNotes}}{{else}}Không có cơi nới hoặc thay đổi kết cấu lớn.{{/if}}</td>
      </tr>
      <tr>
        <td class="font-bold">Lịch sử lún / nghiêng / nứt trước đây</td>
        <td class="text-center">{{#if previousSettlementOrTilt}}<span style="color: #c2410c; font-weight: bold;">CÓ</span>{{else}}KHÔNG{{/if}}</td>
        <td>{{#if previousSettlementNotes}}{{previousSettlementNotes}}{{else}}Chủ nhà không ghi nhận hiện tượng lún nghiêng bất thường trước đây.{{/if}}</td>
      </tr>
      <tr>
        <td class="font-bold">Sự cố hỏa hoạn / ngập lụt / va chạm xe</td>
        <td class="text-center">{{#if fireOrAccident}}<span style="color: #c2410c; font-weight: bold;">CÓ</span>{{else}}KHÔNG{{/if}}</td>
        <td>{{#if fireOrAccidentNotes}}{{fireOrAccidentNotes}}{{else}}Không có tiền sử hỏa hoạn hoặc ngập lụt ảnh hưởng móng.{{/if}}</td>
      </tr>
      <tr>
        <td class="font-bold">Thiết bị / Hoạt động nhạy cảm rung động</td>
        <td class="text-center">{{#if sensitiveEquipmentPresent}}<span style="color: #c2410c; font-weight: bold;">CÓ</span>{{else}}KHÔNG{{/if}}</td>
        <td>{{#if sensitiveEquipmentNotes}}{{sensitiveEquipmentNotes}}{{else}}Không có thiết bị y tế hoặc phòng thí nghiệm đặc biệt nhạy cảm.{{/if}}</td>
      </tr>
    </tbody>
  </table>

  {{#if historyDetailsNote}}
  <div class="note-box note-box-warning">
    <div class="note-title">⚠️ Ghi chú bổ sung về lịch sử biến động công trình:</div>
    {{historyDetailsNote}}
  </div>
  {{/if}}

  <!-- =====================================================================
       MỤC 4: PHẠM VI TIẾP CẬN & HỒ SƠ ẢNH ĐỊNH DANH (P-01 ĐẾN P-04)
       ===================================================================== -->
  <h2 class="section-header">4. PHẠM VI TIẾP CẬN VÀ HỒ SƠ ẢNH ĐỊNH DANH</h2>

  <h3 class="subsection-header">4.1. Khả năng tiếp cận các khu vực</h3>
  <table class="tech-table">
    <thead>
      <tr>
        <th style="width: 25%;">Khu vực khảo sát</th>
        <th class="text-center" style="width: 20%;">Mức độ tiếp cận</th>
        <th>Ghi chú / Nguyên nhân hạn chế tiếp cận</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Mặt ngoài công trình</td>
        <td class="text-center font-bold">{{scopeAccess.facadeStatus}}</td>
        <td>{{scopeAccess.facadeNote}}</td>
      </tr>
      <tr>
        <td>Tầng trệt</td>
        <td class="text-center font-bold">{{scopeAccess.groundFloorStatus}}</td>
        <td>{{scopeAccess.groundFloorNote}}</td>
      </tr>
      <tr>
        <td>Các tầng lầu</td>
        <td class="text-center font-bold">{{scopeAccess.upperFloorsStatus}}</td>
        <td>{{scopeAccess.upperFloorsNote}}</td>
      </tr>
      <tr>
        <td>Sân thượng / Mái</td>
        <td class="text-center font-bold">{{scopeAccess.roofStatus}}</td>
        <td>{{scopeAccess.roofNote}}</td>
      </tr>
      <tr>
        <td>Tầng hầm (nếu có)</td>
        <td class="text-center font-bold">{{scopeAccess.basementStatus}}</td>
        <td>{{scopeAccess.basementNote}}</td>
      </tr>
    </tbody>
  </table>

  {{#if scopeAccess.inaccessibleAreasReason}}
  <div class="note-box note-box-danger">
    <div class="note-title">⛔ Ghi chú về khu vực không thể tiếp cận / hạn chế khảo sát:</div>
    {{scopeAccess.inaccessibleAreasReason}}
  </div>
  {{/if}}

  <!-- BỘ 4 ẢNH ĐỊNH DANH NGOẠI THẤT -->
  <h3 class="subsection-header">4.2. Bộ ảnh nhận diện ngoại thất chuẩn (P-01 đến P-04)</h3>
  <div class="photo-grid-2x2">
    <!-- P-01 -->
    <div class="photo-card">
      {{#if p01.url}}
        <img src="{{p01.url}}" alt="P-01 Biển số nhà">
      {{else}}
        <div style="height: 160px; display: flex; align-items: center; justify-content: center; background: #f1f5f9; color: #64748b; font-size: 8pt;">
          {{#if p01.isNotApplicable}}KHÔNG ÁP DỤNG: {{p01.naReason}}{{else}}Chưa có ảnh P-01{{/if}}
        </div>
      {{/if}}
      <div class="photo-meta">
        <div class="photo-title">P-01: BIỂN SỐ NHÀ / TÊN CÔNG TRÌNH</div>
        <div>Mã ảnh: {{p01.photoId}} | Ngày: {{p01.capturedAt}}</div>
        <div>Tọa độ GPS: {{p01.gpsLat}}, {{p01.gpsLng}}</div>
      </div>
    </div>

    <!-- P-02 -->
    <div class="photo-card">
      {{#if p02.url}}
        <img src="{{p02.url}}" alt="P-02 Mặt đứng chính">
      {{else}}
        <div style="height: 160px; display: flex; align-items: center; justify-content: center; background: #f1f5f9; color: #64748b; font-size: 8pt;">
          Chưa có ảnh P-02
        </div>
      {{/if}}
      <div class="photo-meta">
        <div class="photo-title">P-02: MẶT ĐỨNG CHÍNH TOÀN CẢNH</div>
        <div>Mã ảnh: {{p02.photoId}} | Ngày: {{p02.capturedAt}}</div>
        <div>Tọa độ GPS: {{p02.gpsLat}}, {{p02.gpsLng}}</div>
      </div>
    </div>

    <!-- P-03 -->
    <div class="photo-card">
      {{#if p03.url}}
        <img src="{{p03.url}}" alt="P-03 Mặt bên hoặc phía sau">
      {{else}}
        <div style="height: 160px; display: flex; align-items: center; justify-content: center; background: #f1f5f9; color: #64748b; font-size: 8pt;">
