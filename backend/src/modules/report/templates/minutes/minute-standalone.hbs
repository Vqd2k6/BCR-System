<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Biên bản hiện trường - {{parcelCode}}{{#if unitCode}} - {{unitCode}}{{/if}}</title>
  <style>
    {{{styles}}}
    .minutes-title { text-align: center; font-size: 16pt; font-weight: bold; margin: 10mm 0 2mm 0; }
    .minutes-subtitle { text-align: center; font-size: var(--fs-c1); color: var(--c-sub); margin-bottom: 6mm; }
    .minutes-label { text-align: center; margin-bottom: 6mm; }
    .minutes-label span { display: inline-block; padding: 2mm 6mm; border: 2px solid #000000; font-weight: bold; font-size: var(--fs-b2); letter-spacing: 0.3px; }
    .minutes-note { margin-top: 5mm; font-size: var(--fs-c1); color: var(--c-sub); font-style: italic; }
  </style>
</head>
<body>
  <div class="a4-page-sheet">
    <div class="report-subpage-topbar">
      <span>LIÊN DANH CRLG – CRSRI – TT | TUYẾN METRO 2 BẾN THÀNH - THAM LƯƠNG</span>
      <span>{{metadata.buildingId}} | {{metadata.reportNo}}</span>
    </div>

    <div class="minutes-title">BIÊN BẢN KHẢO SÁT HIỆN TRƯỜNG</div>
    <div class="minutes-subtitle">SITE-SURVEY RECORD</div>
    <div class="minutes-label"><span>{{label}}</span></div>

    <table class="tech-table">
      <tr>
        <td class="label-col">Mã công trình<br><span class="text-muted">Building code</span></td>
        <td class="val-col font-bold">{{parcelCode}}{{#if unitCode}} / {{unitCode}}{{/if}}</td>
      </tr>
      <tr>
        <td class="label-col">Trạng thái hồ sơ<br><span class="text-muted">Report status</span></td>
        <td class="val-col font-bold">{{statusText}}</td>
      </tr>
      <tr>
        <td class="label-col">Địa chỉ công trình<br><span class="text-muted">Building address</span></td>
        <td class="val-col">{{appendix3.address.vi}}</td>
      </tr>
      <tr>
        <td class="label-col">Thời gian lập biên bản<br><span class="text-muted">Record time</span></td>
        <td class="val-col font-bold">{{appendix3.surveyTime}}</td>
      </tr>
      <tr>
        <td class="label-col">Đại diện chủ sở hữu<br><span class="text-muted">Owner representative</span></td>
        <td class="val-col">{{appendix3.ownerRepresentative.vi}}</td>
      </tr>
      <tr>
        <td class="label-col">Số điện thoại liên hệ<br><span class="text-muted">Contact phone</span></td>
        <td class="val-col">{{appendix3.contactPhone}}</td>
      </tr>
      <tr>
        <td class="label-col">Chính quyền địa phương<br><span class="text-muted">Local authority</span></td>
        <td class="val-col">{{appendix3.localAuthority.vi}}</td>
      </tr>
      <tr>
        <td class="label-col">Đơn vị tư vấn giám sát<br><span class="text-muted">Supervision consultant</span></td>
        <td class="val-col">{{appendix3.supervisionConsultant.vi}}</td>
      </tr>
      <tr>
        <td class="label-col">Đơn vị khảo sát<br><span class="text-muted">Survey unit</span></td>
        <td class="val-col font-bold">{{appendix3.surveyUnit.vi}}</td>
      </tr>
    </table>

    <div class="minutes-note">Bản trích xuất từ hệ thống lúc {{exportedAt}}. Số trang bản quét kèm theo: {{appendix3.signedRecordPages.length}}.</div>
  </div>

  {{#each appendix3.signedRecordPages}}
  <div class="a4-page-sheet">
    <div class="report-subpage-topbar">
      <span>LIÊN DANH CRLG – CRSRI – TT | TUYẾN METRO 2 BẾN THÀNH - THAM LƯƠNG</span>
      <span>{{../metadata.buildingId}} | {{../metadata.reportNo}}</span>
    </div>
    <div style="text-align: center; margin: 6px 0;">
      <img src="{{this.base64}}" alt="{{this.title.vi}}"
        style="height: 240mm; max-width: 100%; object-fit: contain; border: 1px solid #000000; display: block; margin: 0 auto;">
    </div>
    <div class="photo-caption text-center font-bold" style="margin-top: 4px;">{{this.title.vi}}</div>
  </div>
  {{/each}}
</body>
</html>
