{{!-- Phụ lục 2: theo từng tầng — mọi tầng đã khảo sát: sơ đồ ghim Z/E, bảng tổng hợp, ảnh bối cảnh + cận cảnh theo từng D. Giữ mã khuyết tật v1 (D-01); STT = số liên tục giữa các tầng, trùng số No.001 trích ở Mục VIII–IX. --}}
<div class="a4-page-sheet" data-section="pl-2">
  <h2 class="chapter-header">PHỤ LỤC 2: THỐNG KÊ KHUYẾT TẬT THEO TẦNG – APPENDIX 2: DEFECT STATISTICS BY FLOOR</h2>
  <p class="v2-text">Phụ lục này trình bày theo từng tầng: sơ đồ vị trí khuyết tật, bảng tổng hợp khuyết tật, ảnh bối cảnh và ảnh cận cảnh của từng khuyết tật. Số đo ghi kèm đơn vị như khi khảo sát.</p>
  <p class="v2-text en">This appendix is presented floor by floor: defect location plan, defect summary table, and the context and close-up photos of each defect. Measurements are shown with their surveyed units.</p>

  {{#each v2.floors}}
    {{!-- is-first-floor: tầng đầu chung trang với tiêu đề + giới thiệu PL2 nên sơ đồ thấp hơn các tầng sau;
         has-no-defects: chừa chỗ cho tiêu đề bảng + lời thông báo ngay dưới sơ đồ, không sinh trang gần trống (styles.css). --}}
    <div class="v2-floor {{#if @first}}is-first-floor{{/if}} {{#unless this.rows.length}}has-no-defects{{/unless}}" data-section="pl-2-{{@index}}" {{#unless @first}}style="break-before: page;"{{/unless}}>
      <h3 class="chapter-header sub-header">{{this.code}} {{this.floorName.vi}} – {{this.floorName.en}}</h3>

      {{#if this.hasAnyMap}}
        <figure class="v2-figure force-light">
          {{#if this.cadSideBySide}}
          {{!-- 2 sơ đồ đều ảnh dọc: đặt cạnh nhau, mỗi ảnh rộng hết 1 cột. --}}
          <div class="v2-cad-pair">
            <div class="v2-cad-col">
              <div class="v2-cad-title">Mặt bằng kiến trúc &amp; vùng Z<i class="en-block">Architectural plan &amp; zones Z</i></div>
              <div class="v2-cad">
                <img src="{{this.mapSrc}}" alt="Sơ đồ vị trí khuyết tật {{this.floorName.vi}}">
                {{#each this.pins}}<div class="pin pin-{{this.typeLower}}" style="left: {{this.pinX}}%; top: {{this.pinY}}%;"><i></i><span>{{this.code}}</span></div>{{/each}}
              </div>
            </div>
            <div class="v2-cad-col">
              <div class="v2-cad-title">Mặt bằng kết cấu &amp; cấu kiện E<i class="en-block">Structural plan &amp; members E</i></div>
              <div class="v2-cad">
                <img src="{{this.structuralMapSrc}}" alt="Sơ đồ kết cấu {{this.floorName.vi}}">
                {{#each this.structuralPins}}<div class="pin pin-{{this.typeLower}}" style="left: {{this.pinX}}%; top: {{this.pinY}}%;"><i></i><span>{{this.code}}</span></div>{{/each}}
              </div>
            </div>
          </div>
          {{else}}
          {{#if this.mapSrc}}
          {{#if this.structuralMapSrc}}<div class="v2-cad-title">Mặt bằng kiến trúc &amp; vùng Z – <i>Architectural plan &amp; zones Z</i></div>{{/if}}
          <div class="v2-cad {{#if this.structuralMapSrc}}is-dual{{/if}}">
            <img src="{{this.mapSrc}}" alt="Sơ đồ vị trí khuyết tật {{this.floorName.vi}}">
            {{#each this.pins}}<div class="pin pin-{{this.typeLower}}" style="left: {{this.pinX}}%; top: {{this.pinY}}%;"><i></i><span>{{this.code}}</span></div>{{/each}}
          </div>
          {{/if}}
          {{#if this.structuralMapSrc}}
            <div class="v2-cad-title">Mặt bằng kết cấu &amp; cấu kiện E – <i>Structural plan &amp; members E</i></div>
            <div class="v2-cad is-dual">
              <img src="{{this.structuralMapSrc}}" alt="Sơ đồ kết cấu {{this.floorName.vi}}">
              {{#each this.structuralPins}}<div class="pin pin-{{this.typeLower}}" style="left: {{this.pinX}}%; top: {{this.pinY}}%;"><i></i><span>{{this.code}}</span></div>{{/each}}
            </div>
          {{/if}}
          {{/if}}
          <figcaption><span class="vi">Hình {{this.code}} – Sơ đồ vị trí khuyết tật – {{this.floorName.vi}}</span><i>Figure {{this.code}} – Defect location plan – {{this.floorName.en}}</i></figcaption>
        </figure>
      {{else}}
        <p class="v2-text">Chưa có sơ đồ mặt bằng tầng. <i>No floor plan available.</i></p>
      {{/if}}

      {{!-- Tiêu đề bảng đi cùng bảng: không để tiêu đề nằm cuối trang còn bảng sang trang sau. --}}
      <div class="v2-keep">
      <div class="v2-figure" style="margin-bottom: 4px;"><figcaption><span class="vi">Bảng {{this.code}} – Tổng hợp khuyết tật – {{this.floorName.vi}}</span><i>Table {{this.code}} – Defect summary – {{this.floorName.en}}</i></figcaption></div>
      {{#if this.rows.length}}
        <table class="v2-table v2-defect-table">
          <thead>
            <tr>
              <th style="width: 5%;">STT<span class="en">No.</span></th>
              <th style="width: 8%;">Mã<span class="en">ID</span></th>
              <th>Vị trí<span class="en">Location</span></th>
              <th>Loại khuyết tật<span class="en">Defect type</span></th>
              <th style="width: 9%;">Rộng (mm)<span class="en">Width (mm)</span></th>
              <th style="width: 10%;">Dài / KT<span class="en">Length / Size</span></th>
              <th style="width: 8%;">Burland<span class="en">Category</span></th>
              <th style="width: 12%;">Mô tả<span class="en">Description</span></th>
            </tr>
          </thead>
          <tbody>
            {{#each this.rows}}
              <tr>
                <td class="num">{{this.noDisplay}}</td>
                <td class="num"><b>{{this.defectId}}</b></td>
                <td>{{this.location.vi}}<span class="en-block">{{this.location.en}}</span></td>
                <td>{{this.typeLabel.vi}}<span class="en-block">{{this.typeLabel.en}}</span></td>
                <td class="num">{{orDash this.widthMmDisplay}}</td>
                <td class="num">{{orDash this.lengthMm}}</td>
                <td class="num">{{this.burlandGrade}}</td>
                <td class="center">{{this.burlandLabel.vi}}<span class="en-block">{{this.burlandLabel.en}}</span></td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      {{else}}
        {{#if this.notice}}<p class="v2-text"><b>{{this.notice.vi}}</b></p><p class="v2-text en"><b><i>{{this.notice.en}}</i></b></p>{{else}}<p class="v2-text">---</p>{{/if}}
      {{/if}}
      </div>

      {{#if this.defectGroups.length}}
        {{#each this.defectGroups}}
          <div class="v2-defect-group">
            {{!-- Tiêu đề + khối ảnh đầu không tách trang; các khối sau chảy tự do. --}}
            <div class="v2-keep">
              {{#if @first}}<div class="v2-figure" style="margin: 10px 0 4px;"><figcaption><span class="vi">Ảnh khuyết tật – {{../floorName.vi}}</span><i>Defect photos – {{../floorName.en}}</i></figcaption></div>{{/if}}
              <h4 class="v2-group-title">{{#if this.noRef}}<b>{{this.noRef}}</b> – {{/if}}<b>{{this.ref}}</b>{{#if this.location}} – {{this.location.vi}}{{/if}} – {{this.typeLabel.vi}} <i>/ {{this.typeLabel.en}}</i>{{#if this.wmaxText}} – {{this.wmaxText}}{{/if}}</h4>
              {{#if this.firstBlock}}{{#with this.firstBlock}}{{> v2-photo-block}}{{/with}}{{/if}}
            </div>
            {{#each this.restBlocks}}{{> v2-photo-block}}{{/each}}
          </div>
        {{/each}}
      {{/if}}
    </div>
  {{/each}}
</div>
