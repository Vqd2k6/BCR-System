  </div>
  <div data-section="sec-9-2">
    <h3 class="chapter-header sub-header">2. Kiến nghị – Recommendations</h3>
    <ol class="v2-ol">
      {{#each v2.recommendations}}<li>{{this.vi}}<span class="en-block">{{this.en}}</span></li>{{/each}}
    </ol>
  </div>
</section>
