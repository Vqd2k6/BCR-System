{{!-- Đầu trang Chrome (mọi trang kể cả bìa). Chỉ dùng style nội tuyến; ảnh phải là data URI. --}}
<div style="width:100%; padding:0 15mm; font-family: Arial, 'Liberation Sans', Helvetica, sans-serif; -webkit-print-color-adjust: exact;">
  <table style="width:100%; border-collapse:collapse; border:1px solid #000; font-size:8.5px; color:#000;">
    <tr>
      <td style="width:22%; border-right:1px solid #000; padding:4px 8px; vertical-align:middle;">
        {{#if metadata.headerLogoBase64}}<img src="{{metadata.headerLogoBase64}}" style="max-height:30px; max-width:100%;">{{/if}}
      </td>
      <td style="width:56%; border-right:1px solid #000; padding:4px 8px; text-align:center; vertical-align:middle; line-height:1.35;">
        <div style="font-weight:bold;">HO CHI MINH CITY MASS RAPID TRANSIT LINE 2</div>
        <div>Ben Thanh – Tham Luong Route</div>
        <div style="font-weight:bold;">Building Condition Survey and Assessment</div>
      </td>
      <td style="width:22%; padding:4px 8px; vertical-align:middle; line-height:1.35; font-size:7.5px;">
        <div><b>Doc. No.:</b> {{v2.docNo}}</div>
        <div><b>Rev.:</b> {{v2.revision}}</div>
        <div><b>Date:</b> {{v2.docDate}}</div>
        <div><b>Page:</b> <span class="pageNumber" style="font-size:9px;"></span> of <span class="totalPages" style="font-size:9px;"></span></div>
      </td>
    </tr>
  </table>
</div>
